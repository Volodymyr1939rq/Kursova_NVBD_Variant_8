  <Source dwd:design-time-name="bd08069c-8ab0-4b15-9be6-6de890ababc5">
    <DataSourceViewID>Inventory Management DW</DataSourceViewID>
  </Source>
  <MdxScripts>
    <MdxScript dwd:design-time-name="3d0fb2d7-f25f-4519-9b74-0d5764f56a7d">
      <ID>MdxScript</ID>
      <Name>MdxScript</Name>
      <CreatedTimestamp>0001-01-01T00:00:00Z</CreatedTimestamp>
      <LastSchemaUpdate>0001-01-01T00:00:00Z</LastSchemaUpdate>
      <Commands>
        <Command>
          <Text>/*
The CALCULATE command controls the aggregation of leaf cells in the cube.
If the CALCULATE command is deleted or modified, the data within the cube is affected.
You should edit this command only if you manually specify how the cube is aggregated.
*/
CALCULATE; 
CREATE MEMBER CURRENTCUBE.[Measures].[Average Receipt]
 AS [Measures].[Line Total] / [Measures].[Fact Inventory Operations Count], 
FORMAT_STRING = "Currency", 
VISIBLE = 1  ; 
CREATE MEMBER CURRENTCUBE.[Measures].[Percent of Total]
 AS [Measures].[Line Total] / (ROOT(), [Measures].[Line Total]), 
FORMAT_STRING = "Percent", 
VISIBLE = 1  ; 
CREATE MEMBER CURRENTCUBE.[Measures].[Margin Percent]
 AS [Measures].[Gross Profit] / [Measures].[Line Total], 
FORMAT_STRING = "Percent", 
VISIBLE = 1  ; 
CREATE MEMBER CURRENTCUBE.[Measures].[YoY Growth]
 AS ([Measures].[Line Total] - (ParallelPeriod([Dim Date].[Calendar].[Calendar Year], 1, [Dim Date].[Calendar].CurrentMember), [Measures].[Line Total])) 
/ 
(ParallelPeriod([Dim Date].[Calendar].[Calendar Year], 1, [Dim Date].[Calendar].CurrentMember), [Measures].[Line Total]), 
FORMAT_STRING = "Percent", 
VISIBLE = 1  ; 
CREATE MEMBER CURRENTCUBE.[Measures].[MoM Growth]
 AS ([Measures].[Line Total] - (ParallelPeriod([Dim Date].[Calendar].[Month Year], 1, [Dim Date].[Calendar].CurrentMember), [Measures].[Line Total])) 
/ 
(ParallelPeriod([Dim Date].[Calendar].[Month Year], 1, [Dim Date].[Calendar].CurrentMember), [Measures].[Line Total]), 
FORMAT_STRING = "Percent", 
VISIBLE = 1  ; 
CREATE MEMBER CURRENTCUBE.[Measures].[Weighted Average Price]
 AS IIF([Measures].[Quantity] = 0, NULL, 
    [Measures].[Line Total] / [Measures].[Quantity]), 
FORMAT_STRING = "Currency", 
VISIBLE = 1  ; 
CREATE MEMBER CURRENTCUBE.[Measures].[YTD Sales]
 AS Aggregate(YTD([Dim Date].[Calendar].CurrentMember), [Measures].[Line Total]), 
FORMAT_STRING = "Currency", 
VISIBLE = 1  ; 
CREATE MEMBER CURRENTCUBE.[Measures].[Previous Year Sales]
 AS (ParallelPeriod([Dim Date].[Calendar].[Calendar Year], 1, [Dim Date].[Calendar].CurrentMember), [Measures].[Line Total]), 
FORMAT_STRING = "Currency", 
VISIBLE = 1  ; 
CREATE MEMBER CURRENTCUBE.[Measures].[Product Rank]
 AS Rank([Dim Product].[Product Name].CurrentMember, 
     Order([Dim Product].[Product Name].[Product Name].Members, [Measures].[Line Total], BDESC)), 
VISIBLE = 1  ; 
CREATE MEMBER CURRENTCUBE.[Measures].[Moving Average 3M]
 AS Avg(LastPeriods(3, [Dim Date].[Calendar].CurrentMember), [Measures].[Line Total]), 
FORMAT_STRING = "Currency", 
VISIBLE = 1  ; </Text>
        </Command>
      </Commands>
    </MdxScript>
  </MdxScripts>
  <Kpis>
    <Kpi dwd:design-time-name="c03a3fce-6665-43fe-b2bc-ad4b28091fdf">
      <ID>KPI</ID>
      <Name>Sales Target KPI</Name>
      <Value>[Measures].[Line Total]</Value>
      <Goal>[Measures].[Previous Year Sales] * 1.1</Goal>
      <Status>IIF([Measures].[Line Total] &gt;= KpiGoal("Sales Target KPI"), 1, 
    IIF([Measures].[Line Total] &gt;= KpiGoal("Sales Target KPI") * 0.9, 0, -1))</Status>
      <Trend>IIF([Measures].[Line Total] &gt; [Measures].[Previous Year Sales], 1, -1)</Trend>
      <TrendGraphic>Standard Arrow</TrendGraphic>
      <StatusGraphic>Gauge - Ascending</StatusGraphic>
    </Kpi>
  </Kpis>
</Cube>