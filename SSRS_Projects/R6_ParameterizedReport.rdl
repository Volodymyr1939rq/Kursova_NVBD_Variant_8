    <DataSet Name="dsMainReport">
      <Query>
        <DataSourceName>DataSource1</DataSourceName>
        <CommandText>="SELECT NON EMPTY { [Measures].[Quantity], [Measures].[Line Total], [Measures].[Gross Profit] } ON COLUMNS, NON EMPTY ( Filter([Dim Warehouse].[Warehouse Name].[Warehouse Name].ALLMEMBERS, [Dim Warehouse].[Warehouse Name].CurrentMember.Name = """ &amp; Parameters!pWarehouse.Value &amp; """) * [Dim Operation Type].[Operation Type Key].[Operation Type Key].ALLMEMBERS * Filter([Dim Product].[Category Name].[Category Name].ALLMEMBERS, [Dim Product].[Category Name].CurrentMember.Name = """ &amp; Parameters!pCategory.Value &amp; """) * [Dim Product].[Product Name].[Product Name].ALLMEMBERS * [Dim Date].[Date Key].[Date Key].ALLMEMBERS ) ON ROWS FROM [Inventory Management DW]"</CommandText>
        <rd:DesignerState>
          <QueryDefinition xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://schemas.microsoft.com/AnalysisServices/QueryDefinition">
