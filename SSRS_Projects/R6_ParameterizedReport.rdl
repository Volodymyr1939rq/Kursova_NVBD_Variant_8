    <DataSet Name="dsProducts">
      <Query>
        <DataSourceName>DataSource1</DataSourceName>
        <CommandText>SELECT NON EMPTY { [Measures].[Quantity] } ON COLUMNS,
NON EMPTY (
    [Dim Product].[Category Name].[Category Name].ALLMEMBERS *
    [Dim Product].[Product Name].[Product Name].ALLMEMBERS
) ON ROWS
FROM [Inventory Management DW]</CommandText>
