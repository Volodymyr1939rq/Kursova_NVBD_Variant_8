              </Filter>
              <Calculations />
              <Aggregates />
              <QueryProperties />
            </QuerySpecification>
            <Query>
              <Statement>SELECT NON EMPTY { [Measures].[Quantity], [Measures].[Line Total], [Measures].[Gross Profit] } ON COLUMNS, NON EMPTY ( [Dim Warehouse].[Warehouse Name].[Warehouse Name].ALLMEMBERS * [Dim Operation Type].[Operation Type Key].[Operation Type Key].ALLMEMBERS * [Dim Product].[Category Name].[Category Name].ALLMEMBERS * [Dim Product].[Product Name].[Product Name].ALLMEMBERS * [Dim Date].[Date Key].[Date Key].ALLMEMBERS ) ON ROWS FROM [Inventory Management DW]</Statement>
              <ParameterDefinitions />
