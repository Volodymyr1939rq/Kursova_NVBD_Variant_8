  <DataSets>
    <DataSet Name="dsSubDetails">
      <Query>
        <DataSourceName>DataSource1</DataSourceName>
        <CommandText>="SELECT { [Measures].[Quantity], [Measures].[Line Total], [Measures].[Gross Profit] } ON COLUMNS, NONEMPTY( Filter([Dim Warehouse].[Warehouse Name].[Warehouse Name].MEMBERS, [Dim Warehouse].[Warehouse Name].CurrentMember.Name = """ &amp; Parameters!pWarehouse.Value &amp; """) * [Dim Product].[Category Name].[Category Name].MEMBERS * [Dim Operation Type].[Operation Type Key].[Operation Type Key].MEMBERS, [Measures].[Quantity] ) ON ROWS FROM [Inventory Management DW]"</CommandText>
        <rd:DesignerState>
          <QueryDefinition xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://schemas.microsoft.com/AnalysisServices/QueryDefinition">
            <CommandType>MDX</CommandType>
            <Type>Query</Type>
            <QuerySpecification xsi:type="MDXQuerySpecification">
              <Select>
                <Items>
                  <Item>
                    <ID xsi:type="Level">
                      <DimensionName>Dim Warehouse</DimensionName>
                      <HierarchyName>Warehouse Name</HierarchyName>
                      <HierarchyUniqueName>[Dim Warehouse].[Warehouse Name]</HierarchyUniqueName>
                      <LevelName>Warehouse Name</LevelName>
                      <UniqueName>[Dim Warehouse].[Warehouse Name].[Warehouse Name]</UniqueName>
                    </ID>
                    <ItemCaption>Warehouse Name</ItemCaption>
                  </Item>
                  <Item>
                    <ID xsi:type="Level">
                      <DimensionName>Dim Product</DimensionName>
                      <HierarchyName>Category Name</HierarchyName>
                      <HierarchyUniqueName>[Dim Product].[Category Name]</HierarchyUniqueName>
                      <LevelName>Category Name</LevelName>
                      <UniqueName>[Dim Product].[Category Name].[Category Name]</UniqueName>
                    </ID>
                    <ItemCaption>Category Name</ItemCaption>
                  </Item>
                  <Item>
                    <ID xsi:type="Level">
                      <DimensionName>Dim Operation Type</DimensionName>
                      <HierarchyName>Operation Type Key</HierarchyName>
                      <HierarchyUniqueName>[Dim Operation Type].[Operation Type Key]</HierarchyUniqueName>
                      <LevelName>Operation Type Key</LevelName>
                      <UniqueName>[Dim Operation Type].[Operation Type Key].[Operation Type Key]</UniqueName>
                    </ID>
                    <ItemCaption>Operation Type Key</ItemCaption>
                  </Item>
                  <Item>
                    <ID xsi:type="Measure">
                      <MeasureName>Quantity</MeasureName>
                      <UniqueName>[Measures].[Quantity]</UniqueName>
                    </ID>
                    <ItemCaption>Quantity</ItemCaption>
                    <FormattedValue>true</FormattedValue>
                  </Item>
                  <Item>
                    <ID xsi:type="Measure">
                      <MeasureName>Line Total</MeasureName>
                      <UniqueName>[Measures].[Line Total]</UniqueName>
                    </ID>
                    <ItemCaption>Line Total</ItemCaption>
                    <FormattedValue>true</FormattedValue>
                  </Item>
                  <Item>
                    <ID xsi:type="Measure">
                      <MeasureName>Gross Profit</MeasureName>
                      <UniqueName>[Measures].[Gross Profit]</UniqueName>
                    </ID>
                    <ItemCaption>Gross Profit</ItemCaption>
                    <FormattedValue>true</FormattedValue>
                  </Item>
                </Items>
              </Select>
              <AutoExecute>false</AutoExecute>
              <From>Inventory Management DW</From>
              <Filter>
                <FilterItems />
              </Filter>
              <Calculations />
              <Aggregates />
              <QueryProperties />
            </QuerySpecification>
            <Query>
              <Statement>SELECT NON EMPTY { [Measures].[Quantity], [Measures].[Line Total], [Measures].[Gross Profit] } ON COLUMNS,
NON EMPTY (
    [Dim Warehouse].[Warehouse Name].[Warehouse Name].MEMBERS *
    [Dim Product].[Category Name].[Category Name].MEMBERS *
    [Dim Operation Type].[Operation Type Key].[Operation Type Key].MEMBERS
) ON ROWS
FROM [Inventory Management DW]</Statement>
              <ParameterDefinitions />
            </Query>
          </QueryDefinition>
        </rd:DesignerState>
      </Query>
