        <CommandText>DEFINE VAR vDimProductCategoryName1 = IF(PATHLENGTH(@DimProductCategoryName) = 1, IF(@DimProductCategoryName &lt;&gt; "", @DimProductCategoryName, BLANK()), IF(PATHITEM(@DimProductCategoryName, 2) &lt;&gt; "", PATHITEM(@DimProductCategoryName, 2), BLANK()))
