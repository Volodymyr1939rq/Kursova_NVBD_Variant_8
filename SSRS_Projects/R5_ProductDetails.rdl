  <DataSets>
    <DataSet Name="dsProductDetails">
      <Query>
        <DataSourceName>DataSource1</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="DimProductProductName">
            <Value>=Parameters!DimProductProductName.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>DEFINE VAR vDimProductProductName1 = IF(PATHLENGTH(@DimProductProductName) = 1, IF(@DimProductProductName &lt;&gt; "", @DimProductProductName, BLANK()), IF(PATHITEM(@DimProductProductName, 2) &lt;&gt; "", PATHITEM(@DimProductProductName, 2), BLANK()))
VAR vDimProductProductName1ALL = PATHLENGTH(@DimProductProductName) &gt; 1 &amp;&amp; PATHITEM(@DimProductProductName, 1, 1) &lt; 1
EVALUATE SUMMARIZECOLUMNS('Dim Product'[Product Name], 'Dim Date'[Calendar Year], FILTER(VALUES('Dim Product'[Product Name]), ((vDimProductProductName1ALL || 'Dim Product'[Product Name] = vDimProductProductName1))), FILTER(VALUES('Dim Operation Type'[Operation Type Key]), ('Dim Operation Type'[Operation Type Key] = VALUE("2"))), "Quantity", [Quantity], "Line Total", [Line Total], "Gross Profit", [Gross Profit])</CommandText>
        <rd:DesignerState>
