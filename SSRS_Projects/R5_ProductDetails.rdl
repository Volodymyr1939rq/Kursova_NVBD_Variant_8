            <Query>
              <Statement>DEFINE VAR vDimProductProductName1 = IF(PATHLENGTH(@DimProductProductName) = 1, IF(@DimProductProductName &lt;&gt; "", @DimProductProductName, BLANK()), IF(PATHITEM(@DimProductProductName, 2) &lt;&gt; "", PATHITEM(@DimProductProductName, 2), BLANK()))
VAR vDimProductProductName1ALL = PATHLENGTH(@DimProductProductName) &gt; 1 &amp;&amp; PATHITEM(@DimProductProductName, 1, 1) &lt; 1
EVALUATE SUMMARIZECOLUMNS('Dim Product'[Product Name], 'Dim Date'[Calendar Year], FILTER(VALUES('Dim Product'[Product Name]), ((vDimProductProductName1ALL || 'Dim Product'[Product Name] = vDimProductProductName1))), FILTER(VALUES('Dim Operation Type'[Operation Type Key]), ('Dim Operation Type'[Operation Type Key] = VALUE("2"))), "Quantity", [Quantity], "Line Total", [Line Total], "Gross Profit", [Gross Profit])</Statement>
              <ParameterDefinitions>
                <ParameterDefinition>
                  <Name>DimProductProductName</Name>
                  <DefaultValues>
                    <DefaultValue>1|Товар номенклатури #1 (серія 2)</DefaultValue>
                  </DefaultValues>
                  <Caption>Product Name</Caption>
                  <HierarchyUniqueName>[Dim Product].[Product Name]</HierarchyUniqueName>
                  <ParameterValuesQuery>
                    <Statement>EVALUATE SELECTCOLUMNS (ADDCOLUMNS (SUMMARIZECOLUMNS (ROLLUPADDISSUBTOTAL ('Dim Product'[Product Name], "h0")), "ParameterLevel", if ([h0], 0, 1)), "ParameterCaption", SWITCH([ParameterLevel], 1, 'Dim Product'[Product Name], "All"), "ParameterValue", [ParameterLevel] &amp; "|" &amp; 'Dim Product'[Product Name], "ParameterLevel", [ParameterLevel], "'Dim Product'[Product Name]", 'Dim Product'[Product Name]) order by 'Dim Product'[Product Name], [ParameterLevel]</Statement>
                    <ParameterizedStatement>
                      <ReferencedParameters />
                    </ParameterizedStatement>
                  </ParameterValuesQuery>
                  <MultipleValues>true</MultipleValues>
                  <AllowBlank>true</AllowBlank>
