              <From>Inventory Management DW</From>
              <Filter>
                <FilterItems>
                  <FilterItem>
                    <HierarchyUniqueName>[Dim Product].[Product Name]</HierarchyUniqueName>
                    <Condition xsi:type="EqualTo">
                      <Members>
                        <Member>
                          <MemberUniqueName>[Dim Product].[Product Name].&amp;[Товар номенклатури #1 (серія 2)]</MemberUniqueName>
                        </Member>
                      </Members>
                      <Parametrized>true</Parametrized>
                    </Condition>
                  </FilterItem>
                  <FilterItem>
                    <HierarchyUniqueName>[Dim Operation Type].[Operation Type Key]</HierarchyUniqueName>
                    <Condition xsi:type="EqualTo">
                      <Members>
                        <Member>
                          <MemberUniqueName>[Dim Operation Type].[Operation Type Key].&amp;[2]</MemberUniqueName>
                        </Member>
                      </Members>
                    </Condition>
                  </FilterItem>
