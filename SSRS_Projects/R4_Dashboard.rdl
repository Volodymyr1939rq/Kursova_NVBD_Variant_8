  <DataSets>
    <DataSet Name="dsDashboard">
      <Query>
        <DataSourceName>DataSource1</DataSourceName>
        <CommandText>EVALUATE SUMMARIZECOLUMNS('Dim Product'[Category Name], 'Dim Date'[Calendar Year], FILTER(VALUES('Dim Operation Type'[Operation Type Key]), ('Dim Operation Type'[Operation Type Key] = VALUE("2"))), "Line Total", [Line Total], "Gross Profit", [Gross Profit], "Quantity", [Quantity])</CommandText>
