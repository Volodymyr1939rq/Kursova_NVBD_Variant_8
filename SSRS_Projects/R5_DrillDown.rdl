            <Query>
              <Statement>EVALUATE SUMMARIZECOLUMNS('Dim Product'[Category Name], 'Dim Product'[Product Name], 'Dim Date'[Calendar Year], FILTER(VALUES('Dim Operation Type'[Operation Type Key]), ('Dim Operation Type'[Operation Type Key] = VALUE("2"))), "Line Total", [Line Total])</Statement>
