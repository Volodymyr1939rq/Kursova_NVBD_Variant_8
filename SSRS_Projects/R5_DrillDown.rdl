  <DataSets>
    <DataSet Name="dsDrillDown">
      <Query>
        <DataSourceName>DataSource1</DataSourceName>
        <CommandText>EVALUATE SUMMARIZECOLUMNS('Dim Product'[Category Name], 'Dim Product'[Product Name], 'Dim Date'[Calendar Year], FILTER(VALUES('Dim Operation Type'[Operation Type Key]), ('Dim Operation Type'[Operation Type Key] = VALUE("2"))), "Line Total", [Line Total])</CommandText>
        <rd:DesignerState>
          <QueryDefinition xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://schemas.microsoft.com/AnalysisServices/QueryDefinition">
