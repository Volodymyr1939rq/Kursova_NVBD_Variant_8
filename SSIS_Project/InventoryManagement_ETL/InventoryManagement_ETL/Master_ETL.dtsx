          SQLTask:SqlStatementSource="INSERT INTO dbo.ETLAuditLog (PackageName, StartTime, Status)&#xA;OUTPUT INSERTED.AuditID&#xA;VALUES ('Master_ETL', SYSDATETIME(), 'Running');"
          SQLTask:ResultType="ResultSetType_SingleRow" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
