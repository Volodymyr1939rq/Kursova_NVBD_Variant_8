      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{C5C650BF-5229-409C-87DB-8C2A2BEBA955}"
          SQLTask:SqlStatementSource="UPDATE dbo.ETLAuditLog&#xA;SET EndTime = SYSDATETIME(),&#xA;    Status = 'Success',&#xA;    RowsInserted = (SELECT COUNT(*) FROM dbo.FactInventoryOperations) + (SELECT COUNT(*) FROM dbo.FactPayments)&#xA;WHERE AuditID = ?;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="0"
            SQLTask:DtsVariableName="User::AuditLogID"
            SQLTask:ParameterDirection="Input"
