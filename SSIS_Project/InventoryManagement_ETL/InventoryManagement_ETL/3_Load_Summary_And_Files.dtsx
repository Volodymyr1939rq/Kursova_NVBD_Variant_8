                    <property
                      dataType="System.String"
                      description="The SQL command to be executed."
                      name="SqlCommand"
                      UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">SELECT TOP 100
    CAST(w.WarehouseID AS NVARCHAR(20)) AS CleanWarehouse,
    f.Quantity AS NumQty,
    CAST(f.UnitPrice AS NUMERIC(18,2)) AS NumPrice
FROM dbo.FactInventoryOperations f
JOIN dbo.DimWarehouse w ON f.WarehouseKey = w.WarehouseKey;</property>
